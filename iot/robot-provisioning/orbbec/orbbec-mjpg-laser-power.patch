-std::shared_ptr<ob::Config> make_streams(const CameraConfig &options) {
+int env_int(const char *name, int fallback) {
+  const char *val = std::getenv(name);
+  if (val == nullptr || *val == '\0') {
+    return fallback;
+  }
+  try {
+    return std::stoi(val);
+  } catch (...) {
+    return fallback;
+  }
+}
+
+bool env_bool(const char *name, bool fallback) {
+  const char *val = std::getenv(name);
+  if (val == nullptr || *val == '\0') {
+    return fallback;
+  }
+  const std::string s(val);
+  if (s == "1" || s == "true" || s == "TRUE" || s == "yes" || s == "on") {
+    return true;
+  }
+  if (s == "0" || s == "false" || s == "FALSE" || s == "no" || s == "off") {
+    return false;
+  }
+  return fallback;
+}
+
+void apply_power_tuning(const std::shared_ptr<ob::Device> &device) {
+  if (!device) {
+    return;
+  }
+  const int laser_ctrl = env_int("LINGTU_ORBBEC_LASER_CONTROL", -1);
+  const int laser_level = env_int("LINGTU_ORBBEC_LASER_ENERGY_LEVEL", -1);
+  try {
+    if (laser_level >= 0 &&
+        device->isPropertySupported(OB_PROP_LASER_ENERGY_LEVEL_INT, OB_PERMISSION_WRITE)) {
+      device->setIntProperty(OB_PROP_LASER_ENERGY_LEVEL_INT, laser_level);
+    }
+    if (laser_ctrl >= 0 &&
+        device->isPropertySupported(OB_PROP_LASER_CONTROL_INT, OB_PERMISSION_WRITE)) {
+      device->setIntProperty(OB_PROP_LASER_CONTROL_INT, laser_ctrl);
+    }
+  } catch (const std::exception &e) {
+    std::cerr << "orbbec power tuning warning: " << e.what() << std::endl;
+  } catch (...) {
+  }
+}
+
