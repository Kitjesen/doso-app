+      use_mjpg ? OB_FORMAT_MJPG : OB_FORMAT_RGB);
+  if (options.depth.width > 0 && options.depth.height > 0 && options.depth.fps > 0) {
+    config->enableVideoStream(
+        OB_STREAM_DEPTH,
+        options.depth.width,
+        options.depth.height,
+        options.depth.fps,
+        OB_FORMAT_Y16);
+  }
   return config;
 }
 
