LINGTU_ORBBEC_PRODUCT_ID=0x0800
LINGTU_ORBBEC_DEVICE_INDEX=0
LINGTU_ORBBEC_SERIAL_NUMBER=
LINGTU_ORBBEC_UID=
LINGTU_ORBBEC_SDK_CONFIG=
LINGTU_ORBBEC_ENABLE_FRAME_SYNC=false
LINGTU_ORBBEC_LASER_CONTROL=0
LINGTU_ORBBEC_LASER_ENERGY_LEVEL=1
LINGTU_ORBBEC_COLOR_MJPG=1
LINGTU_CAMERA_PUBLISH_IMAGE_DDS=false
LINGTU_CAMERA_COLOR_TOPIC=/camera/color/image_raw
