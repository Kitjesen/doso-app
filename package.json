    "test:db": "supabase test db supabase/tests/database",
    "test:functions": "npx --yes deno@2.5.6 test --allow-read --allow-env --config supabase/functions/deno.json supabase/functions/tests",
    "test:account-email-db": "supabase test db supabase/tests/database/account_email_outbox.test.sql",
    "test:account-email-ops": "node scripts/verify-account-email-outbox.mjs",
