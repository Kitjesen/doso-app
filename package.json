  "scripts": {
    "ios:cloud": "node scripts/ios-cloud.mjs",
    "test:ios-build-config": "node --test scripts/ios-build-config.test.mjs scripts/ios-cloud.test.mjs scripts/ios-source-archive.test.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
