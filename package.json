    "test:db-hosted-public-probe": "node --test scripts/verify-hosted-public-rpc.test.mjs",
    "test:config": "powershell -NoProfile -ExecutionPolicy Bypass -File supabase/tests/config.test.ps1",
    "test:auth": "node scripts/verify-auth.mjs",
    "test:auth-storage": "node scripts/test-auth-storage-sanitizer.mjs",
    "test:pkce": "node scripts/verify-pkce-recovery.mjs",
    "test:network": "node scripts/verify-network-backend.mjs",
    "network:check": "node --env-file-if-exists=.env.local scripts/check-backend-connectivity.mjs",
    "test:connection": "node --test scripts/check-backend-connectivity.test.mjs scripts/brainstem-readonly.test.mjs scripts/ble-discovery-ios.test.mjs",
    "test:wifi-discovery": "node --test scripts/robot-hotspot-rules.test.mjs scripts/wifi-discovery-session.test.mjs scripts/wifi-discovery-panel.test.mjs scripts/robot-wifi-native.test.mjs scripts/robot-wifi-permissions.test.mjs scripts/robot-connection-screen.test.mjs",
    "test:brainstem-readiness": "node --test scripts/brainstem-integration-readiness.test.mjs",
    "test:control-state": "node --test scripts/control-action-state.test.mjs",
    "test:brainstem-bridge": "npm --prefix iot/brainstem-bridge test",
    "test:device-enrollment": "node --test scripts/device-enrollment-service.test.mjs",
    "test:brainstem-simulation": "node --test scripts/brainstem-simulation-session.test.mjs scripts/brainstem-simulation-stream.test.mjs",
    "test:identity-hosted": "node scripts/verify-identity-hosted.mjs",
    "test:old-client-compatibility": "node scripts/verify-old-client-compatibility.mjs",
    "test:social-auth": "node scripts/verify-social-auth.mjs && node --test --test-concurrency=1 scripts/social-session-operation.test.mjs",
    "test:authing-broker": "node scripts/verify-authing-broker.mjs",
    "test:authing-oidc-verifier": "node scripts/verify-authing-oidc-verifier.mjs",
    "authing:verify-live-oidc": "node --env-file-if-exists=.env.local scripts/verify-authing-oidc.mjs",
    "test:apple-auth-core": "node scripts/verify-apple-auth-core.mjs",
    "test:apple-display-name-recovery": "node scripts/verify-apple-display-name-recovery.mjs",
    "auth-links:build": "node scripts/build-auth-link-site.mjs",
    "auth-links:test": "node --test scripts/build-auth-link-site.test.mjs",
    "auth-links:verify-deployment": "node link-host/verify-deployment.mjs",
    "test:auth-errors": "node --test scripts/auth-operation-error.test.mjs",
    "test:auth-request-fetch": "node --experimental-strip-types --test scripts/auth-request-fetch.test.mjs",
    "test:nav": "node --test scripts/bottom-nav.test.mjs",
    "test:app-font": "node --test scripts/app-font.test.mjs",
    "test:otp-errors": "node --experimental-strip-types scripts/verify-otp-errors.mts",
    "test:production-baseline": "node scripts/verify-production-baseline.mjs",
    "test:robot-protocol": "node --experimental-strip-types scripts/verify-robot-protocol.mts",
    "test:robot-provisioning": "node --experimental-strip-types scripts/verify-robot-provisioning.mts",
    "test:g008-command-delivery": "node --experimental-strip-types scripts/verify-g008-command-delivery.mts",
    "test:g008-diagnostic-ui": "node --experimental-strip-types scripts/verify-g008-diagnostic-ui.mts",
    "test:robot-simulator": "node --experimental-strip-types scripts/verify-robot-simulator.mjs",
    "test:robot-capability-readiness": "node --experimental-strip-types scripts/verify-robot-capability-readiness.mjs",
    "test:robot-command-executor": "node --experimental-strip-types scripts/verify-robot-command-executor.mts",
    "test:robot-transport-contract": "node --experimental-strip-types scripts/verify-robot-transport-contract.mjs",
    "test:robot-ingress-contract": "node scripts/verify-robot-ingress-contract.mjs",
    "test:robot-command-worker-contract": "node scripts/verify-robot-command-worker-contract.mjs",
    "test:robot-operations-observability": "node scripts/verify-robot-operations-observability.mjs",
    "test:firmware-lifecycle": "node --experimental-strip-types scripts/verify-firmware-lifecycle.mts",
    "test:provisioning-ui": "node --experimental-strip-types scripts/verify-provisioning-ui.mts",
    "test:firmware-update-ui": "node --experimental-strip-types scripts/verify-firmware-update-ui.mts",
    "test:ble-discovery": "node --experimental-strip-types scripts/verify-ble-discovery.mts && npm run test:ble-introspection",
    "test:ble-introspection": "expo config --type introspect --json | node scripts/verify-ble-introspection.mjs",
    "test:control-ui": "node scripts/verify-control-ui.mjs && node --experimental-strip-types --test scripts/verify-control-layout.mts && node --test scripts/joystick-input.test.mjs scripts/control-joystick.test.mjs scripts/control-screen-interaction.test.mjs",
    "test:figma-control-script": "node scripts/verify-figma-control-align.mjs",
    "test:release-gate": "node scripts/verify-release-gate.mjs",
    "test:release-gate-core": "node --test scripts/release-gate.test.mjs",
    "email:build": "node scripts/build-email-template-suite.mjs",
    "email:check": "node scripts/build-email-template-suite.mjs --check && node scripts/manage-auth-email-templates.mjs",
    "email:test": "node --test --test-isolation=none scripts/manage-auth-email-templates.test.mjs",
    "email:send-previews": "node scripts/send-email-template-previews.mjs",
    "email:send-previews:secure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/send-email-template-previews.ps1",
    "email:send-previews:test": "node --test scripts/send-email-template-previews.test.mjs",
    "email:verify": "node scripts/manage-auth-email-templates.mjs --remote",
    "email:sync": "node scripts/build-email-template-suite.mjs --check && node scripts/manage-auth-email-templates.mjs --sync",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist-web",
    "export:android": "expo export --platform android --output-dir dist-android"
  },
  "private": true
}