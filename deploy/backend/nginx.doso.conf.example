# Template only. Include in the host Nginx http context after review.
# Add as a separate site; retain all existing site configuration.
# Replace the reserved hostname and certificate paths with an approved hostname
# and its publicly trusted HTTPS certificate. No certificate is supplied here.
map $http_upgrade $doso_connection_upgrade {
    default upgrade;
    '' close;
}

log_format doso_api_status escape=json '{"method":"$request_method","status":"$status","upstream_status":"$upstream_status","request_time":"$request_time"}';

server {
    listen 443 ssl;
    server_name api.doso.invalid;

    ssl_certificate /REPLACE_WITH_TRUSTED_CERTIFICATE/fullchain.pem;
    ssl_certificate_key /REPLACE_WITH_PRIVATE_KEY_PATH/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log /var/log/nginx/doso-api-access.log doso_api_status;
    error_log /dev/null;
    # shortcut: Add structured error diagnostics only after verifying URL, token and header redaction; retain status-only access diagnostics meanwhile.

    # Match the existing DOSO Caddy allowlist, including only the reviewed function.
    location ~ ^/(?:auth/v1/|rest/v1/|realtime/v1/|storage/v1/|graphql/v1$|functions/v1/account-sessions(?:/|$)) {
        proxy_pass http://127.0.0.1:18000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Sb-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $doso_connection_upgrade;
        proxy_read_timeout 3600s;
    }

    # Studio, MCP, the upstream hello function and every other path stay private.
    location / {
        return 404;
    }
}
