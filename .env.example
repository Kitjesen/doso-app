# Hosted/web Supabase endpoint. Production must use the project's HTTPS URL.
# Example: https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Android Emulator reaches the Windows host through 10.0.2.2.
# For a physical phone, replace this with the computer's LAN IP during local testing.
# Production Android should use the same hosted HTTPS URL as web.
EXPO_PUBLIC_SUPABASE_URL_ANDROID=http://10.0.2.2:54321

# Safe to embed in the client only when Row Level Security is enabled.
# Never put a secret/service-role key in an EXPO_PUBLIC variable.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-supabase-publishable-key

# Displayed in the account terminal registry.
EXPO_PUBLIC_APP_VERSION=0.0.1
EXPO_PUBLIC_DOSO_BLE_NAME_PREFIX=DOSO
EXPO_PUBLIC_DOSO_BLE_SERVICE_UUID=

# HTTPS origin claimed by the production iOS Universal Link and Android App Link.
# This value must be an origin only (no path, query, fragment, or embedded credentials).
# Production CI/EAS must inject: EXPO_PUBLIC_AUTH_LINK_ORIGIN=https://links.dosorobotics.com
# Keep it unset in this local template so native development uses `doso://` callbacks.
# Web ignores this mobile-link origin and uses its validated `window.location.origin`; every deployed
# Web origin's exact `/auth/callback` URL must be added to the Supabase Redirect URLs allowlist.

# Static verified-link host build inputs. These are public signing identities, not private keys.
# Inject real production values only in the links.dosorobotics.com deployment environment.
# DOSO_APPLE_TEAM_ID=A1B2C3D4E5
# DOSO_ANDROID_APP_LINK_FINGERPRINTS=AA:BB:...:FF,11:22:...:00

# Social login stays disabled until both the provider dashboard and the client are configured.
# These are public feature flags/identifiers only. Never place Apple .p8, WeChat AppSecret,
# QQ AppKey, Supabase service-role keys, or generated Apple client secrets in EXPO_PUBLIC values.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false

# Apple Services ID, ordered Client IDs, callback, .p8 and rotating client secret are configured
# only in Apple Developer and Supabase Auth. The App uses the canonical auth callback above.

# WeChat and QQ are routed through two separate OIDC-broker connections (recommended: Authing)
# and two Supabase Custom OIDC providers. These values must exactly match the provider identifiers
# created in Supabase; identifiers are public and must use the `custom:` prefix.
EXPO_PUBLIC_WECHAT_AUTH_ENABLED=false
EXPO_PUBLIC_WECHAT_SUPABASE_PROVIDER=custom:wechat
EXPO_PUBLIC_QQ_AUTH_ENABLED=false
EXPO_PUBLIC_QQ_SUPABASE_PROVIDER=custom:qq

# Server-only credentials (Authing OIDC client secrets, WeChat AppSecret, QQ AppKey, Apple .p8,
# SMTP password, management access token, Edge Function secrets, and service-role key) must be
# stored in the corresponding provider dashboard, Supabase Dashboard/CLI secrets, or CI secrets.
# Never add them to an EXPO_PUBLIC variable or commit them to this file.
